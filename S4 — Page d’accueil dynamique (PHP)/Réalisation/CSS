* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    color: #222;
    background: #f5f5f5;
    line-height: 1.6;
}

.container {
    width: 90%;
    max-width: 1100px;
    margin: auto;
}

.header {
    background: #171717;
    padding: 20px 0;
}

.header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
}

.header h1 {
    color: #d4af37;
}

nav {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}

nav a {
    color: white;
    text-decoration: none;
}

nav a:hover {
    color: #d4af37;
}

.hero {
    background: #252525;
    color: white;
    text-align: center;
    padding: 90px 20px;
}

.subtitle {
    color: #d4af37;
    margin-bottom: 15px;
}

.hero h2 {
    font-size: 38px;
}

.hero h3 {
    color: #d4af37;
    margin: 10px 0;
}

.hero p {
    margin-bottom: 25px;
}

.btn {
    display: inline-block;
    background: #d4af37;
    color: #171717;
    padding: 12px 25px;
    border-radius: 5px;
    text-decoration: none;
    font-weight: bold;
}

.btn:hover {
    background: #b89425;
}

.section {
    padding: 65px 0;
}

.section h2 {
    text-align: center;
    margin-bottom: 25px;
    font-size: 30px;
}

.section-description {
    text-align: center;
    margin-bottom: 25px;
}

.projects-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 25px;
}

.project-card {
    width: calc(33.333% - 17px);
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s;
}

.project-card:hover {
    transform: translateY(-5px);
}

.project-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
}

.project-content {
    padding: 20px;
}

.category {
    color: #a78620;
    font-size: 13px;
    font-weight: bold;
}

.project-content h3 {
    margin: 10px 0;
}

.project-content p {
    color: #666;
    margin-bottom: 12px;
}

.value {
    font-weight: bold;
}

.status {
    display: inline-block;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: bold;
}

.authenticated {
    background: #e5f5e9;
    color: #247a3d;
}

.pending {
    background: #fff3d6;
    color: #9a6a0b;
}

.documents {
    background: white;
    text-align: center;
}

.documents p {
    max-width: 750px;
    margin: auto;
}

.contact {
    text-align: center;
    background: #f5f5f5;
}

.contact p {
    margin-bottom: 20px;
}
.footer {
    background: #171717;
    color: white;
    text-align: center;
    padding: 22px;
}

@media (max-width: 768px) {

    .header .container {
        flex-direction: column;
    }

    .project-card {
        width: calc(50% - 13px);
    }

    .hero h2 {
        font-size: 29px;
    }
}

@media (max-width: 500px) {

    .project-card {
        width: 100%;
    }

    nav {
        justify-content: center;
    }
}
