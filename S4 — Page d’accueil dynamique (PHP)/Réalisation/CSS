
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f5f5;
    color: #222;
    line-height: 1.6;
}

.container {
    width: 90%;
    max-width: 1100px;
    margin: auto;
}
header {
    background: #171717;
    color: white;
    padding: 20px 0;
}

.header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
}

header h1 {
    color: #d4af37;
}

nav {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}

nav a {
    color: white;
    text-decoration: none;
}

nav a:hover {
    color: #d4af37;
}
.hero {
    background: #252525;
    color: white;
    text-align: center;
    padding: 90px 20px;
}

.hero h2 {
    font-size: 36px;
}

.hero h3 {
    color: #d4af37;
    margin: 10px 0;
}

.hero p {
    margin: 15px 0 25px;
}
.btn {
    display: inline-block;
    background: #d4af37;
    color: #171717;
    padding: 12px 25px;
    border-radius: 5px;
    text-decoration: none;
    font-weight: bold;
}
.about {
    padding: 60px 0;
    text-align: center;
}

.about h2,
.projects h2 {
    margin-bottom: 20px;
}
.projects {
    padding: 50px 0;
}

.projects h2 {
    text-align: center;
}

.total {
    text-align: center;
    margin-bottom: 25px;
}

.projects-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 25px;
}

.project-card {
    width: calc(33.333% - 17px);
    background: white;
    padding: 25px;
    border-radius: 8px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
}

.project-card h3 {
    color: #9b7717;
    margin-bottom: 12px;
}

.project-card h4 {
    margin-top: 15px;
}

.project-card ul {
    margin: 10px 0 15px 20px;
}

.status {
    display: inline-block;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 13px;
}

.completed {
    background: #d8f5df;
    color: #187b35;
}

.progress {
    background: #fff0c2;
    color: #8a6200;
}
.contact {
    background: white;
    text-align: center;
    padding: 50px 20px;
}

.contact p {
    margin: 15px 0 25px;
}
footer {
    background: #171717;
    color: white;
    text-align: center;
    padding: 20px;
}
@media (max-width: 768px) {
    .project-card {
        width: calc(50% - 13px);
    }

    .header-content {
        flex-direction: column;
    }
}

@media (max-width: 500px) {
    .project-card {
        width: 100%;
    }

    .hero h2 {
        font-size: 27px;
    }
}
