
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f5f5f5;
    color: #222;
    line-height: 1.6;
}

header {
    background-color: #151515;
    color: white;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}

.logo {
    color: #d4af37;
    font-size: 28px;
    font-weight: bold;
}

nav {
    display: flex;
    gap: 25px;
    flex-wrap: wrap;
}

nav a {
    color: white;
    text-decoration: none;
    transition: 0.3s;
}

nav a:hover {
    color: #d4af37;
}

.hero {
    min-height: 430px;
    background-color: #202020;
    color: white;
    display: flex;
    align-items: center;
    padding: 70px 10%;
}

.hero-content {
    max-width: 700px;
}

.subtitle {
    color: #d4af37;
    margin-bottom: 15px;
}

.hero h1 {
    font-size: 38px;
    margin-bottom: 10px;
}

.hero h1 span {
    color: #d4af37;
}

.hero h2 {
    margin-bottom: 20px;
    color: #ddd;
}

.hero-content > p:not(.subtitle) {
    margin-bottom: 25px;
}

.btn {
    display: inline-block;
    background-color: #d4af37;
    color: #151515;
    padding: 12px 22px;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
}

.btn:hover {
    background-color: white;
}

.about,
.skills,
.projects,
.contact {
    padding: 65px 8%;
    text-align: center;
}

section h2 {
    font-size: 30px;
    margin-bottom: 25px;
    color: #b18b20;
}

.about p {
    max-width: 750px;
    margin: auto;
}

.skills {
    background-color: #eaeaea;
}

.skills-container {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
}

.skill {
    background-color: #151515;
    color: #d4af37;
    padding: 12px 25px;
    border-radius: 6px;
}

.projects {
    background-color: white;
}

.section-description {
    color: #777;
    margin-bottom: 30px;
}

.projects-container {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;
}

.project-card {
    background-color: #f7f7f7;
    width: 310px;
    border-radius: 10px;
    overflow: hidden;
    text-align: left;
    box-shadow: 0 3px 12px #00000012;
    transition: 0.3s;
}

.project-card:hover {
    transform: translateY(-5px);
}

.project-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
}

.project-content {
    padding: 20px;
}

.project-content h3 {
    margin-bottom: 10px;
    color: #222;
}

.project-content p {
    color: #666;
    margin-bottom: 15px;
}

.tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 18px;
}

.tags span {
    background-color: #e8dfc2;
    color: #765c12;
    padding: 5px 10px;
    border-radius: 4px;
    font-size: 12px;
}

.project-link {
    color: #9b781d;
    text-decoration: none;
    font-weight: bold;
}

.contact {
    background-color: #eeeeee;
}

.contact p {
    margin-bottom: 20px;
}

footer {
    background-color: #151515;
    color: white;
    text-align: center;
    padding: 22px;
}
@media (max-width: 700px) {

    header {
        flex-direction: column;
        gap: 18px;
    }

    nav {
        justify-content: center;
        gap: 15px;
    }

    .hero h1 {
        font-size: 29px;
    }

    .hero {
        padding: 55px 8%;
    }

    .project-card {
        width: 100%;
        max-width: 400px;
    }
}
