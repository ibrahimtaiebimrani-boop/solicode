
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f5f5f5;
    color: #222;
    line-height: 1.6;
}
.container {
    width: 90%;
    max-width: 1100px;
    margin: 0 auto;
}
.header {
    background-color: #171717;
    padding: 20px 0;
}

.header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
}

.logo {
    color: #d4af37;
    font-size: 28px;
}

.navigation {
    display: flex;
    gap: 25px;
    flex-wrap: wrap;
}

.navigation a {
    color: white;
    text-decoration: none;
    font-size: 15px;
}

.navigation a:hover,
.navigation a.active {
    color: #d4af37;
}
.hero {
    background-color: #252525;
    color: white;
    text-align: center;
    padding: 90px 20px;
}

.hero-subtitle {
    color: #d4af37;
    margin-bottom: 15px;
    font-weight: bold;
}

.hero h2 {
    font-size: 36px;
    margin-bottom: 15px;
}

.hero p {
    max-width: 650px;
    margin: 0 auto 25px;
    color: #ddd;
}
.btn {
    display: inline-block;
    background-color: #d4af37;
    color: #171717;
    padding: 12px 25px;
    border-radius: 5px;
    text-decoration: none;
    font-weight: bold;
}

.btn:hover {
    background-color: #b89425;
}
.articles {
    padding: 65px 0;
}

.section-title {
    text-align: center;
    margin-bottom: 35px;
}

.section-title h2 {
    font-size: 30px;
    margin-bottom: 8px;
}

.section-title p {
    color: #666;
}

.articles-grid {
    display: flex;
    gap: 25px;
    flex-wrap: wrap;
}

.article-card {
    background-color: white;
    width: calc(33.333% - 17px);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.article-card img {
    width: 100%;
    height: 210px;
    object-fit: cover;
}

.article-content {
    padding: 20px;
}

.category {
    color: #b18b20;
    font-size: 13px;
    font-weight: bold;
}

.article-content h3 {
    margin: 10px 0;
    font-size: 19px;
}

.article-content p {
    color: #666;
    margin-bottom: 15px;
}

.read-more {
    color: #9b7717;
    text-decoration: none;
    font-weight: bold;
}
.about {
    background-color: white;
    padding: 40px;
    margin-bottom: 35px;
    border-radius: 8px;
    text-align: center;
}

.about h2 {
    margin-bottom: 15px;
}
.contact {
    text-align: center;
    padding: 35px 20px 60px;
}

.contact h2 {
    margin-bottom: 10px;
}

.contact p {
    margin-bottom: 20px;
}
.footer {
    background-color: #171717;
    color: white;
    text-align: center;
    padding: 22px;
}
@media (max-width: 768px) {
    .header .container {
        flex-direction: column;
    }

    .navigation {
        justify-content: center;
        gap: 15px;
    }

    .hero h2 {
        font-size: 27px;
    }

    .article-card {
        width: calc(50% - 13px);
    }
}

@media (max-width: 500px) {
    .article-card {
        width: 100%;
    }

    .about {
        padding: 25px;
    }
}
