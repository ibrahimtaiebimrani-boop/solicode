
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    color: #202535;
    background-color: #ffffff;
    line-height: 1.7;
}

.container {
    width: 90%;
    max-width: 1100px;
    margin: auto;
}
.header {
    background-color: #ffffff;
    border-bottom: 1px solid #e8eaf0;
    padding: 20px 0;
    position: sticky;
    top: 0;
    z-index: 10;
}

.header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    color: #202535;
    font-size: 27px;
    font-weight: bold;
    text-decoration: none;
}

.logo span {
    color: #6c63ff;
}

nav {
    display: flex;
    gap: 25px;
}

nav a {
    text-decoration: none;
    color: #646b7c;
    font-size: 14px;
    transition: 0.3s;
}

nav a:hover {
    color: #6c63ff;
}
.hero {
    background-color: #171d31;
    color: white;
    padding: 95px 0;
}

.hero-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
}

.hero-text {
    max-width: 620px;
}

.label,
.section-label {
    color: #756dff;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
}

.hero h1 {
    font-size: 43px;
    line-height: 1.3;
    margin: 20px 0;
}

.hero h1 span {
    color: #938bff;
}

.hero p {
    color: #c4c9d8;
    margin-bottom: 30px;
}

.btn {
    display: inline-block;
    background-color: #6c63ff;
    color: white;
    padding: 13px 24px;
    border-radius: 7px;
    text-decoration: none;
    transition: 0.3s;
}

.btn:hover {
    background-color: #5148db;
    transform: translateY(-3px);
}

.hero-image {
    width: 300px;
    height: 250px;
    flex-shrink: 0;
    background-color: #292f48;
    border: 1px solid #454d70;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.image-content {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}

.image-content span {
    background-color: #393f5d;
    color: #a9a3ff;
    padding: 15px 20px;
    border-radius: 8px;
    font-weight: bold;
}
.section-heading {
    margin-bottom: 30px;
}

.section-heading h2,
.about-content h2,
.contact-section h2 {
    font-size: 30px;
    margin: 10px 0;
}

.section-heading p {
    color: #737b8d;
}
.categories-section {
    padding: 65px 0;
    background-color: #f7f8fc;
}

.category-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.category {
    display: inline-block;
    text-decoration: none;
    background-color: white;
    color: #646b7c;
    border: 1px solid #e6e8ef;
    padding: 9px 18px;
    border-radius: 25px;
    font-size: 13px;
    transition: 0.3s;
}

.category:hover {
    color: #6c63ff;
    border-color: #6c63ff;
}

.category.active {
    background-color: #6c63ff;
    color: white;
    border-color: #6c63ff;
}
.articles-section {
    padding: 75px 0;
}

.articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.article-card {
    border: 1px solid #e8eaf0;
    border-radius: 12px;
    overflow: hidden;
    background-color: white;
    transition: 0.3s;
}

.article-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 25px rgba(0, 0, 0, 0.07);
}

.article-image {
    height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    font-size: 22px;
    font-weight: bold;
    letter-spacing: 1px;
}

.image-one {
    background: #252e49;
}

.image-two {
    background: #745d91;
}

.image-three {
    background: #315e60;
}

.article-content {
    padding: 23px;
}

.category-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: bold;
    padding: 5px 11px;
    border-radius: 20px;
}

.blue {
    background-color: #e6edff;
    color: #4261c5;
}

.pink {
    background-color: #ffe8f0;
    color: #cf5585;
}

.green {
    background-color: #e4f7ee;
    color: #328663;
}

.article-date {
    color: #9197a5;
    font-size: 12px;
    margin: 12px 0;
}

.article-content h3 {
    font-size: 19px;
    line-height: 1.4;
    margin-bottom: 12px;
}

.article-content p {
    font-size: 14px;
    color: #707789;
    margin-bottom: 20px;
}

.read-more {
    text-decoration: none;
    color: #6c63ff;
    font-size: 14px;
    font-weight: bold;
}

.read-more:hover {
    text-decoration: underline;
}
.about-section {
    background-color: #f7f8fc;
    padding: 75px 0;
}

.about-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
}

.about-content > div:first-child {
    max-width: 700px;
}

.about-content p {
    color: #707789;
    margin-top: 12px;
}

.about-number {
    width: 180px;
    height: 180px;
    flex-shrink: 0;
    background-color: #171d31;
    color: #938bff;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    font-size: 25px;
}
.contact-section {
    padding: 75px 0;
    text-align: center;
}

.contact-section p {
    color: #707789;
    margin: 15px auto 25px;
}
.footer {
    background-color: #171d31;
    color: #c4c9d8;
    padding: 25px 0;
}

.footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
}

.footer-logo {
    color: white;
    font-size: 20px;
    font-weight: bold;
    text-decoration: none;
}

.footer-content p {
    font-size: 13px;
}

.footer-content > a:last-child {
    color: #a9a3ff;
    text-decoration: none;
    font-size: 13px;
}
@media (max-width: 850px) {

    .hero-content {
        flex-direction: column;
        text-align: center;
    }

    .articles-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (max-width: 600px) {

    .header-content {
        flex-direction: column;
        gap: 18px;
    }

    nav {
        justify-content: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .hero {
        padding: 65px 0;
    }

    .hero h1 {
        font-size: 32px;
    }

    .hero-image {
        width: 100%;
        max-width: 300px;
    }

    .articles-grid {
        grid-template-columns: 1fr;
    }

    .about-content {
        flex-direction: column;
        align-items: flex-start;
    }

    .about-number {
        width: 140px;
        height: 140px;
    }

    .footer-content {
        flex-direction: column;
        text-align: center;
    }

}