
<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArtVault - Détail de l'objet</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header>
        <div class="logo">
            ◇ ArtVault
        </div>

        <nav>
            <a href="#">Tableau de bord</a>
            <a href="#">Ma collection</a>
            <a href="#">Documents</a>
            <a href="#">Paramètres</a>
        </nav>
    </header>

    <main class="container">

        <div class="breadcrumb">
            Accueil / Ma collection / Détail de l'objet
        </div>

        <section class="page-title">
            <h1>Détail de l'objet</h1>
            <p>Consultez les informations de votre collection.</p>
        </section>

        <section class="object-card">

            <div class="object-image">
                <img src="images/montre.jpg" alt="Montre Rolex Submariner">
            </div>

            <div class="object-details">

                <span class="category">Montre de collection</span>

                <h2>Rolex Submariner</h2>

                <p class="description">
                    Une montre de collection reconnue pour son design
                    intemporel et sa qualité exceptionnelle.
                </p>

                <div class="value-box">
                    <p>Valeur estimée</p>
                    <h3>12 500 €</h3>
                </div>

                <div class="information">

                    <div>
                        <span>Référence</span>
                        <strong>SUB-2026-001</strong>
                    </div>

                    <div>
                        <span>Catégorie</span>
                        <strong>Montre</strong>
                    </div>

                    <div>
                        <span>Date d'acquisition</span>
                        <strong>15/03/2025</strong>
                    </div>

                    <div>
                        <span>État</span>
                        <strong>Excellent</strong>
                    </div>

                    <div>
                        <span>Authenticité</span>
                        <strong>Vérifiée</strong>
                    </div>

                </div>

            </div>

        </section>

        <section class="additional-info">

            <div class="info-card">
                <h2>Description</h2>

                <p>
                    Cet objet fait partie d'une collection privée.
                    Toutes les informations relatives à son acquisition,
                    son état et sa valeur sont conservées dans ArtVault.
                </p>
            </div>

            <div class="info-card">
                <h2>Documents associés</h2>

                <ul>
                    <li>Certificat d'authenticité</li>
                    <li>Facture d'achat</li>
                </ul>
            </div>

        </section>

        <section class="actions">
            <a href="#" class="btn-primary">Modifier l'objet</a>
            <a href="#" class="btn-secondary">Retour à la collection</a>
        </section>

    </main>

    <footer>
        <p>© 2026 ArtVault - Votre patrimoine, en toute confiance.</p>
    </footer>

</body>
</html>
