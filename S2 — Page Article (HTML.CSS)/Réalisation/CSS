
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f5f5f5;
    color: #222;
    line-height: 1.6;
}
header {
    background-color: #151515;
    color: white;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}

.logo {
    color: #d4af37;
    font-size: 26px;
    font-weight: bold;
}

nav {
    display: flex;
    gap: 25px;
    flex-wrap: wrap;
}

nav a {
    color: white;
    text-decoration: none;
}

nav a:hover {
    color: #d4af37;
}
.container {
    width: 90%;
    max-width: 1100px;
    margin: 35px auto;
}

.breadcrumb {
    color: #777;
    margin-bottom: 25px;
}

.page-title {
    margin-bottom: 25px;
}

.page-title h1 {
    color: #b18b20;
    font-size: 32px;
}

.object-card {
    display: flex;
    gap: 35px;
    background-color: white;
    padding: 25px;
    border-radius: 12px;
    flex-wrap: wrap;
}

.object-image {
    flex: 1;
    min-width: 280px;
}

.object-image img {
    width: 100%;
    height: 350px;
    object-fit: cover;
    border-radius: 10px;
}

.object-details {
    flex: 1;
    min-width: 280px;
}

.category {
    color: #b18b20;
    font-weight: bold;
}

.object-details h2 {
    font-size: 28px;
    margin: 10px 0;
}

.description {
    color: #666;
    margin-bottom: 20px;
}

.value-box {
    background-color: #151515;
    color: white;
    padding: 18px;
    border-radius: 8px;
    margin-bottom: 20px;
}

.value-box h3 {
    color: #d4af37;
    font-size: 27px;
}

.information {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
}

.information div {
    display: flex;
    flex-direction: column;
}

.information span {
    color: #888;
    font-size: 14px;
}

.additional-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 25px;
}

.info-card {
    background-color: white;
    padding: 25px;
    border-radius: 10px;
}

.info-card h2 {
    color: #b18b20;
    margin-bottom: 15px;
}

.info-card ul {
    padding-left: 20px;
}

.actions {
    display: flex;
    gap: 15px;
    margin-top: 25px;
    flex-wrap: wrap;
}

.actions a {
    padding: 12px 22px;
    text-decoration: none;
    border-radius: 5px;
}

.btn-primary {
    background-color: #151515;
    color: #d4af37;
}

.btn-secondary {
    background-color: #ddd;
    color: #222;
}

footer {
    background-color: #151515;
    color: white;
    text-align: center;
    padding: 22px;
    margin-top: 40px;
}

@media (max-width: 700px) {

    header {
        flex-direction: column;
        gap: 18px;
    }

    nav {
        justify-content: center;
    }

    .additional-info {
        grid-template-columns: 1fr;
    }

    .information {
        grid-template-columns: 1fr;
    }

    .object-image img {
        height: 260px;
    }
}
