
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jeu du nombre secret</title>
    <link rel="stylesheet" href="jeu.css">
    <script src="jeu.js" defer></script>
</head>
<body>

    <main class="game-container">

        <h1>Jeu du nombre secret</h1>

        <p>
            Devinez le nombre secret entre 1 et 100.
        </p>

        <form id="guess-form">

            <label for="guess">Votre nombre :</label>

            <input
                type="text"
                id="guess"
                inputmode="numeric"
                placeholder="Entrez un nombre"
                autocomplete="off"
            >

            <button type="submit">Vérifier</button>

        </form>

        <p id="feedback" aria-live="polite">
            Bonne chance !
        </p>

        <p>
            Nombre d'essais :
            <span id="attempts">0</span>
        </p>

        <button type="button" id="reset-button">
            Nouvelle partie
        </button>

    </main>

</body>
</html>
