
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f6f7fb;
    color: #202535;
    line-height: 1.7;
}

.container {
    width: 90%;
    max-width: 1100px;
    margin: auto;
}
.header {
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    padding: 20px 0;
}

.header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
}

.logo {
    color: #202535;
    font-size: 25px;
    font-weight: bold;
    text-decoration: none;
}

.logo span {
    color: #6c63ff;
}

nav {
    display: flex;
    gap: 25px;
}

nav a {
    text-decoration: none;
    color: #606779;
    font-size: 14px;
}

nav a:hover {
    color: #6c63ff;
}
.breadcrumb {
    display: flex;
    gap: 10px;
    margin: 30px 0;
    color: #777;
    font-size: 14px;
}

.breadcrumb a {
    color: #6c63ff;
    text-decoration: none;
}
.project-hero {
    background-color: #171d31;
    color: white;
    padding: 65px 45px;
    border-radius: 15px;
}

.project-label {
    color: #a8a1ff;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
}

.project-hero h1 {
    font-size: 50px;
    margin: 15px 0 0;
}

.project-hero h2 {
    color: #b7b9cb;
    font-size: 20px;
    font-weight: normal;
}

.project-hero p {
    max-width: 650px;
    color: #d0d2df;
    margin: 25px 0;
}

.status {
    display: inline-block;
    background-color: #323a55;
    color: #a8a1ff;
    padding: 7px 18px;
    border-radius: 20px;
    font-size: 13px;
}
.project-information {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin: 25px 0;
}

.info-card {
    background-color: white;
    padding: 22px;
    border: 1px solid #e7e8ef;
    border-radius: 10px;
}

.info-card h3 {
    color: #858b9b;
    font-size: 13px;
}

.info-card p {
    font-weight: bold;
    margin-top: 8px;
}
.content-section {
    background-color: white;
    padding: 35px;
    margin-bottom: 20px;
    border: 1px solid #e7e8ef;
    border-radius: 12px;
}

.content-section h2 {
    margin-bottom: 20px;
    font-size: 24px;
}

.content-section p {
    color: #697185;
    margin-bottom: 15px;
}

.content-section ul {
    padding-left: 22px;
    color: #697185;
}

.content-section li {
    margin-bottom: 10px;
}
.features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.feature-card {
    background-color: #f6f7fb;
    padding: 22px;
    border-radius: 10px;
}

.feature-card h3 {
    margin-bottom: 10px;
}

.feature-card p {
    font-size: 14px;
    margin: 0;
}
.technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}
.technologies span {
    background-color: #eeedff;
    color: #6259e8;
    padding: 9px 18px;
    border-radius: 20px;
    font-weight: bold;
}
.back-link {
    display: inline-block;
    margin: 10px 0 40px;
    color: #6259e8;
    font-weight: bold;
    text-decoration: none;
}
.footer {
    background-color: #171d31;
    color: white;
    text-align: center;
    padding: 25px;
    font-size: 13px;
}
.game-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

.game-main {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 45px 15px;
}

.game-card {
    background-color: white;
    width: 100%;
    max-width: 520px;
    padding: 35px;
    border-radius: 15px;
    border: 1px solid #e5e7eb;
    text-align: center;
}

.game-card h1 {
    margin: 15px 0;
}

.game-card p {
    color: #697185;
    margin-bottom: 20px;
}

.game-input {
    width: 100%;
    padding: 14px;
    border: 1px solid #d7d9e3;
    border-radius: 8px;
    font-size: 17px;
    margin-bottom: 12px;
}

.game-button {
    padding: 12px 20px;
    border: none;
    border-radius: 8px;
    background-color: #6c63ff;
    color: white;
    font-weight: bold;
    cursor: pointer;
    margin: 5px;
}

.game-button:hover {
    background-color: #5148db;
}

.reset-button {
    background-color: #343b50;
}

.feedback {
    min-height: 30px;
    font-weight: bold;
    margin-top: 20px;
}

.attempts {
    color: #6c63ff;
    font-weight: bold;
    margin-top: 12px;
}
@media (max-width: 768px) {

    .header-content {
        flex-direction: column;
    }

    nav {
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
    }

    .project-hero {
        padding: 40px 25px;
    }

    .project-hero h1 {
        font-size: 38px;
    }

    .project-information {
        grid-template-columns: repeat(2, 1fr);
    }

    .features {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 480px) {

    .project-information {
        grid-template-columns: 1fr;
    }

    .content-section {
        padding: 22px;
    }

    .project-hero h1 {
        font-size: 32px;
    }

    .game-card {
        padding: 25px 18px;
    }
}
