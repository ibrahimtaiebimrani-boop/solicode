
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f5f5f5;
    color: #222;
    line-height: 1.6;
}

header {
    background-color: #151515;
    color: white;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}

.logo {
    font-size: 25px;
    font-weight: bold;
    color: #d4af37;
}

nav {
    display: flex;
    gap: 25px;
    flex-wrap: wrap;
}

nav a {
    color: white;
    text-decoration: none;
}

nav a:hover {
    color: #d4af37;
}

.container {
    width: 90%;
    max-width: 1100px;
    margin: 35px auto;
}

.breadcrumb {
    color: #777;
    margin-bottom: 25px;
}

.project-header {
    margin-bottom: 30px;
}

.project-header h1 {
    font-size: 36px;
    color: #b18b20;
}

.status {
    display: inline-block;
    background-color: #e8dfc2;
    color: #765c12;
    padding: 5px 15px;
    border-radius: 20px;
    margin-top: 15px;
}

.project-content {
    background-color: white;
    padding: 25px;
    border-radius: 12px;
}

.project-image img {
    width: 100%;
    border-radius: 10px;
    display: block;
}

.project-info {
    margin-top: 25px;
}

.project-info h2 {
    color: #b18b20;
    margin: 20px 0 10px;
}

.project-info ul {
    padding-left: 25px;
}

.technologies {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 10px;
}

.technologies span {
    background-color: #151515;
    color: #d4af37;
    padding: 8px 15px;
    border-radius: 5px;
}

.back-button {
    display: inline-block;
    margin-top: 25px;
    padding: 12px 20px;
    background-color: #151515;
    color: white;
    text-decoration: none;
    border-radius: 5px;
}

.back-button:hover {
    background-color: #d4af37;
    color: #151515;
}

footer {
    background-color: #151515;
    color: white;
    text-align: center;
    padding: 20px;
    margin-top: 40px;
}

@media (max-width: 600px) {
    header {
        flex-direction: column;
        gap: 15px;
    }

    nav {
        justify-content: center;
    }

    .project-header h1 {
        font-size: 28px;
    }
}
